<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — floq</title>
    <link rel="icon" type="image/png" href="~/img/hand-black.png" />
    <link rel="stylesheet" href="~/css/floq.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<header class="app-header">
    <a class="app-brand" href="/Billing">
        <img class="app-brand-mark" src="~/img/hand-black.png" alt="" aria-hidden="true" />
        <span class="app-brand-word">floq</span>
    </a>
    <nav class="app-nav">
        <a href="/Billing" class="@(ViewData["NavActive"] as string == "dashboard" ? "is-active" : "")">Übersicht</a>
        <a href="/Billing/Documents" class="@(ViewData["NavActive"] as string == "documents" ? "is-active" : "")">Belege</a>
        <a href="/Settings/CompanyProfile" class="@(ViewData["NavActive"] as string == "settings" ? "is-active" : "")">Einstellungen</a>
    </nav>
    <div class="app-user">
        <span class="app-user-name">@User.Identity?.Name</span>
        <a class="app-logout" href="/auth/logout">Abmelden</a>
    </div>
</header>
<main class="app-main">
    @RenderBody()
</main>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
