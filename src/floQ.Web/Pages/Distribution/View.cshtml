@page "/d"
@model floQ.Web.Pages.Distribution.ViewModel
@{
    Layout = null;
    ViewData["Title"] = Model.IsValid ? $"{Model.DocumentTypeName} {Model.DocumentNumber}" : "Dokument";
}
<!DOCTYPE html>
@* White-Label: diese Seite trägt ausschließlich den Brand des Ausstellers —
   kein floQ-Branding gegenüber dem Endkunden (Rechnungsempfänger). *@
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"]</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
            background: #f5f5f7;
            color: #1d1d1f;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        header {
            background: #fff;
            border-bottom: 1px solid #e5e7eb;
            padding: 14px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
        }
        .who { font-weight: 700; font-size: 15px; }
        .what { color: #6b7280; font-size: 13px; }
        .dl {
            display: inline-block;
            background: #1d1d1f;
            color: #fff;
            padding: 9px 20px;
            border-radius: 999px;
            text-decoration: none;
            font-weight: 600;
            font-size: 13px;
        }
        main { flex: 1; padding: 20px; display: flex; justify-content: center; }
        .frame-wrap { width: 100%; max-width: 900px; }
        iframe {
            width: 100%;
            height: calc(100vh - 130px);
            min-height: 500px;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            background: #fff;
        }
        .msg {
            margin: auto;
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 40px;
            max-width: 420px;
            text-align: center;
        }
        .msg h1 { font-size: 18px; margin-bottom: 8px; }
        .msg p { color: #6b7280; font-size: 14px; line-height: 1.6; }
        footer { text-align: center; padding: 12px; font-size: 11px; color: #9ca3af; }
    </style>
</head>
<body>
@if (Model.IsValid)
{
    <header>
        <div>
            <div class="who">@Model.CompanyName</div>
            <div class="what">@Model.DocumentTypeName @Model.DocumentNumber</div>
        </div>
        <a class="dl" href="/d?handler=Download&t=@Uri.EscapeDataString(Model.Token)">PDF herunterladen</a>
    </header>
    <main>
        <div class="frame-wrap">
            <iframe src="/d?handler=Pdf&t=@Uri.EscapeDataString(Model.Token)#toolbar=0" title="@Model.DocumentTypeName"></iframe>
        </div>
    </main>
    <footer>@Model.CompanyName@(string.IsNullOrEmpty(Model.CompanyEmail) ? "" : $" · {Model.CompanyEmail}")</footer>
}
else
{
    <main>
        <div class="msg">
            <h1>@(Model.IsExpired ? "Link abgelaufen" : "Dokument nicht gefunden")</h1>
            <p>
                @if (Model.IsExpired)
                {
                    <text>Dieser Dokumenten-Link ist abgelaufen. Bitte wenden Sie sich an den Aussteller, um einen neuen Link zu erhalten.</text>
                }
                else
                {
                    <text>Der aufgerufene Link ist ungültig. Bitte prüfen Sie, ob der Link vollständig kopiert wurde.</text>
                }
            </p>
        </div>
    </main>
}
</body>
</html>
