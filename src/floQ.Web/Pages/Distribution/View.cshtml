@page "/d"
@model floQ.Web.Pages.Distribution.ViewModel
@{
    Layout = null;
    ViewData["Title"] = Model.IsValid ? $"{Model.DocumentTypeName} {Model.DocumentNumber}" : "Dokument";
}
<!DOCTYPE html>
@* White-Label: diese Seite trägt ausschließlich den Brand des Ausstellers —
   kein floq-Branding gegenüber dem Endkunden (Rechnungsempfänger). *@
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/floq.css" asp-append-version="true" />
</head>
<body>
@if (Model.IsValid)
{
    <div class="pub">
        <header class="pub-header">
            <div>
                <div class="pub-who">@Model.CompanyName</div>
                <div class="pub-what">@Model.DocumentTypeName @Model.DocumentNumber</div>
            </div>
            <a class="pub-dl" href="/d?handler=Download&t=@Uri.EscapeDataString(Model.Token)">PDF herunterladen</a>
        </header>
        <main class="pub-main">
            <iframe class="pub-frame" src="/d?handler=Pdf&t=@Uri.EscapeDataString(Model.Token)#toolbar=0" title="@Model.DocumentTypeName"></iframe>
        </main>
        <footer class="pub-foot">@Model.CompanyName@(string.IsNullOrEmpty(Model.CompanyEmail) ? "" : $" · {Model.CompanyEmail}")</footer>
    </div>
}
else
{
    <div class="pub">
        <main class="pub-main">
            <div class="pub-msg">
                <h1>@(Model.IsExpired ? "Link abgelaufen" : "Dokument nicht gefunden")</h1>
                <p>
                    @if (Model.IsExpired)
                    {
                        <text>Dieses Dokument ist nicht mehr abrufbar. Bitte wenden Sie sich an den Aussteller, um einen neuen Link zu erhalten.</text>
                    }
                    else
                    {
                        <text>Der aufgerufene Link ist ungültig. Bitte prüfen Sie, ob er vollständig kopiert wurde.</text>
                    }
                </p>
            </div>
        </main>
    </div>
}
</body>
</html>
