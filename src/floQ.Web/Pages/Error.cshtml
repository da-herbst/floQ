@page
@model ErrorModel
@{
    ViewData["Title"] = "Fehler";
    Layout = null;
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>floQ — Fehler</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
            background: #FAF7F2; color: #1A1A1A;
            display: grid; place-items: center; min-height: 100vh;
            margin: 0; padding: 2rem; text-align: center;
        }
        h1 { font-size: 2rem; font-weight: 700; letter-spacing: -0.03em; margin-bottom: 0.5rem; }
        p  { color: #6b6b6b; max-width: 32rem; line-height: 1.5; }
        code { background: rgba(0,0,0,0.06); padding: 0.1em 0.4em; border-radius: 4px; font-size: 0.9em; }
    </style>
</head>
<body>
    <main>
        <h1>Da ist etwas schiefgelaufen.</h1>
        <p>
            Ein unerwarteter Fehler ist aufgetreten.
            @if (Model.ShowRequestId)
            {
                <text>Request-ID: <code>@Model.RequestId</code></text>
            }
        </p>
    </main>
</body>
</html>
