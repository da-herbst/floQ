@page
@model ErrorModel
@{
    ViewData["Title"] = "Fehler";
    Layout = null;
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>floq — Fehler</title>
    <link rel="icon" type="image/png" href="~/img/hand-black.png" />
    <link rel="stylesheet" href="~/css/floq.css" asp-append-version="true" />
</head>
<body>
    <main class="center-page">
        <img class="err-mark" src="~/img/hand-black.png" alt="" />
        <div class="err-title">Da ist etwas schiefgelaufen.</div>
        <div class="err-sub">
            Der Fehler ist protokolliert. Probier’s gleich nochmal.
            @if (Model.ShowRequestId)
            {
                <br /><span class="err-code" style="margin-top:8px;display:inline-block">@Model.RequestId</span>
            }
        </div>
        <a class="err-link" href="/Billing">Zur Übersicht</a>
    </main>
</body>
</html>
