@page "/auth/login"
@model floQ.Web.Pages.Auth.LoginModel
@{
    ViewData["Title"] = "Anmelden — floq";
    Layout = null;
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/png" href="~/img/hand-black.png" />
    <link rel="stylesheet" href="~/css/floq.css" asp-append-version="true" />
</head>
<body>
    <main class="center-page">
        <div class="auth-shell">
            <a href="/" class="auth-brand">
                <img src="~/img/hand-black.png" alt="" />
                <span>floq</span>
            </a>

            <h1 class="auth-title">Anmelden</h1>
            <p class="auth-lead">Mit Passkey. Touch ID, Windows Hello, YubiKey — was du registriert hast.</p>

            <form id="login-form" class="auth-form" novalidate>
                <div class="field">
                    <label for="email">E-Mail</label>
                    <input type="email" name="email" id="email" required autocomplete="username webauthn" />
                </div>
                <button class="btn btn-primary" type="submit">Mit Passkey anmelden</button>
            </form>

            <form id="code-form" class="auth-form" novalidate hidden>
                <div class="field">
                    <label for="code">Anmeldecode</label>
                    <input type="text" name="code" id="code" inputmode="numeric" pattern="[0-9]{6}"
                           maxlength="6" placeholder="6-stelliger Code" autocomplete="one-time-code" />
                </div>
                <button class="btn btn-primary" type="submit">Mit Code anmelden</button>
            </form>

            <div id="status" class="auth-status" role="status" aria-live="polite"></div>

            <p class="auth-alt" style="margin-top:32px"><a href="#" id="code-toggle">Kein Passkey zur Hand? Code per E-Mail anfordern</a></p>
            <p class="auth-alt" style="margin-top:12px">Noch kein Konto? <a href="/auth/register">Registrieren</a></p>
        </div>
    </main>

    <script src="~/js/webauthn.js" asp-append-version="true"></script>
    <script src="~/js/login.js" asp-append-version="true"></script>
    <script src="~/js/login-code.js" asp-append-version="true"></script>
</body>
</html>
