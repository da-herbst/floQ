@page "/auth/register"
@model floQ.Web.Pages.Auth.RegisterModel
@{
    ViewData["Title"] = "Registrieren — floq";
    Layout = null;
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/png" href="~/img/hand-black.png" />
    <link rel="stylesheet" href="~/css/floq.css" asp-append-version="true" />
</head>
<body>
    <main class="center-page">
        <div class="auth-shell">
            <a href="/" class="auth-brand">
                <img src="~/img/hand-black.png" alt="" />
                <span>floq</span>
            </a>

            <h1 class="auth-title">Registrieren</h1>
            <p class="auth-lead">Ein Passkey statt Passwort — dein Gerät übernimmt das.</p>

            <form id="register-form" class="auth-form" novalidate>
                <div class="field">
                    <label for="email">E-Mail</label>
                    <input type="email" name="email" id="email" required autocomplete="email" />
                </div>
                <div class="field">
                    <label for="displayName">Anzeigename</label>
                    <input type="text" name="displayName" id="displayName" required autocomplete="name" />
                </div>
                <div class="field">
                    <label for="credentialName">Passkey-Bezeichnung</label>
                    <input type="text" name="credentialName" id="credentialName" placeholder="z. B. MacBook Touch ID" />
                </div>
                <button class="btn btn-primary" type="submit">Passkey erstellen</button>
            </form>

            <div id="status" class="auth-status" role="status" aria-live="polite"></div>

            <p class="auth-alt" style="margin-top:52px">Schon dabei? <a href="/auth/login">Anmelden</a></p>
        </div>
    </main>

    <script src="~/js/webauthn.js" asp-append-version="true"></script>
    <script src="~/js/register.js" asp-append-version="true"></script>
</body>
</html>
