@page
@model IndexModel
@{
    ViewData["Title"] = "floQ";
    Layout = null;
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>floQ</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        html, body { height: 100%; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
            background: #0f1115;
            color: #e8eaed;
            display: grid;
            place-items: center;
            min-height: 100vh;
            padding: 2rem;
        }
        .card { text-align: center; max-width: 28rem; }
        h1 {
            font-size: clamp(3rem, 12vw, 5.5rem);
            font-weight: 700;
            letter-spacing: -0.04em;
            line-height: 1;
        }
        h1 .q { color: #ffb000; }
        p.tag { margin-top: 1rem; font-size: 1rem; color: #9aa0a6; letter-spacing: 0.02em; }
        p.note { margin-top: 2.5rem; font-size: 0.85rem; color: #5f6368; }
    </style>
</head>
<body>
    <div class="card">
        <h1>flo<span class="q">Q</span></h1>
        <p class="tag">Verrechnung. Unaufgeregt.</p>
        <p class="note">In Vorbereitung.</p>
    </div>
</body>
</html>
