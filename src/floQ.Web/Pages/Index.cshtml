@page
@model IndexModel
@{
    ViewData["Title"] = "floq — nur Cash is’ fesch";
    Layout = null;
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="floq — Verrechnung. Unaufgeregt." />
    <title>floq — nur Cash is’ fesch</title>
    <link rel="icon" type="image/png" href="~/img/hand-black.png" />
    <link rel="apple-touch-icon" href="~/img/hand-black.png" />
    <link rel="stylesheet" href="~/css/floq.css" asp-append-version="true" />
</head>
<body>
    <main class="center-page">
        <div class="lockup">
            <img class="lockup-mark" src="~/img/hand-black.png" alt="floq" />
            <div class="lockup-word">floq</div>
            <div class="lockup-ipa">[ˈflɔɐk]</div>
            <div class="lockup-claim">nur Cash is’ fesch</div>
            <div class="lockup-actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="primary" href="/Billing">Zur App</a>
                    <a href="/auth/logout">Angemeldet als @User.Identity.Name · Abmelden</a>
                }
                else
                {
                    <a class="primary" href="/auth/login">Anmelden</a>
                    <a href="/auth/register">Registrieren</a>
                }
            </div>
        </div>
        <div class="page-foot">In Vorbereitung</div>
    </main>
</body>
</html>
