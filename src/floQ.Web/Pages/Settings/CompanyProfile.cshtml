@page
@model floQ.Web.Pages.Settings.CompanyProfileModel
@{
    Layout = "_LayoutApp";
    ViewData["Title"] = "Firmenprofil";
    ViewData["NavActive"] = "settings";
}

<div class="page-head">
    <div>
        <div class="page-title">Firmenprofil</div>
        <div class="page-sub">Absender, Footer und Briefpapier deiner Belege — dein Kunde sieht ausschließlich diesen Brand.</div>
    </div>
    <button class="btn btn-primary" id="btnSaveProfile">Speichern</button>
</div>

<div class="two-col">
    <div>
        <div class="block">
            <div class="sb-heading">Stammdaten</div>
            <div class="form-grid block-body">
                <div class="field span-2"><label>Firmenname / Name *</label><input id="fLegalName" /></div>
                <div class="field span-2"><label>Straße</label><input id="fStreet" /></div>
                <div class="field"><label>PLZ</label><input id="fZipCode" /></div>
                <div class="field"><label>Ort</label><input id="fCity" /></div>
                <div class="field"><label>Land (ISO-2)</label><input id="fCountryCode" maxlength="2" placeholder="AT" /></div>
                <div class="field"><label>UID</label><input id="fVatId" placeholder="ATU…" /></div>
                <div class="field"><label>E-Mail</label><input id="fEmail" type="email" /></div>
                <div class="field"><label>Telefon</label><input id="fPhone" /></div>
                <div class="field span-2"><label>Website</label><input id="fWebsite" /></div>
            </div>
        </div>

        <div class="block">
            <div class="sb-heading">Bankverbindung</div>
            <div class="form-grid cols-211 block-body">
                <div class="field mono"><label>IBAN</label><input id="fIban" /></div>
                <div class="field mono"><label>BIC</label><input id="fBic" /></div>
                <div class="field"><label>Bank</label><input id="fBankName" /></div>
            </div>
        </div>

        <div class="block">
            <div class="sb-heading">Umsatzsteuer</div>
            <div class="block-body">
                <div class="field-check">
                    <input type="checkbox" id="fIsSmallBusiness" />
                    <label for="fIsSmallBusiness">Kleinunternehmerregelung (§6 Abs 1 Z 27 UStG)
                        <span class="fc-sub">Neue Belege starten ohne USt, der Pflichthinweis wird gedruckt.</span>
                    </label>
                </div>
                <div class="field" style="margin-top:24px"><label>Eigener Hinweistext</label><textarea id="fTaxExemptionText" rows="2" placeholder="Leer = gesetzlicher Standardtext."></textarea></div>
            </div>
        </div>
    </div>

    <aside>
        <div class="sb-heading">Briefpapier</div>
        <div class="aside-note" style="padding:16px 0">Ein Vektor-PDF als Hintergrund jeder Beleg-Seite. Das Druckbild funktioniert auch ohne.</div>
        <div class="meta-row" style="padding:4px 0 16px"><span>Status</span><span class="meta-value" id="letterheadStatus">–</span></div>
        <input type="file" id="letterheadFile" accept="application/pdf" hidden />
        <button class="btn btn-secondary btn-block" type="button" id="btnUploadLetterhead">PDF hochladen</button>
        <div style="text-align:center;padding-top:14px">
            <button class="btn-text" type="button" id="btnDeleteLetterhead" hidden>Briefpapier entfernen</button>
        </div>

        <div class="sb-heading" style="margin-top:40px">Weitere Einstellungen</div>
        <div style="padding-top:14px"><a class="aside-link" href="/Settings/Mail">E-Mail-Versand</a> →</div>
    </aside>
</div>

@section Scripts {
    <script src="~/js/api.js" asp-append-version="true"></script>
    <script src="~/js/company-profile.js" asp-append-version="true"></script>
}
