@page
@model floQ.Web.Pages.Settings.MailModel
@{
    Layout = "_LayoutApp";
    ViewData["Title"] = "E-Mail-Versand";
    ViewData["NavActive"] = "settings";
}

<div class="page-head">
    <div>
        <div class="page-title">E-Mail-Versand</div>
        <div class="page-sub">Belege gehen über deinen eigenen Mail-Server raus — dein Kunde sieht nur deinen Absender.</div>
    </div>
    <div class="hstack">
        <button class="btn btn-secondary" id="btnTestMail">Test-Mail senden</button>
        <button class="btn btn-primary" id="btnSaveMail">Speichern</button>
    </div>
</div>

<div class="two-col">
    <div>
        <div class="sb-heading">SMTP-Zugang</div>
        <div class="form-grid cols-21 block-body">
            <div class="field mono"><label>Host *</label><input id="fHost" placeholder="smtp.example.at" /></div>
            <div class="field mono"><label>Port</label><input id="fPort" type="number" value="587" min="1" max="65535" /></div>
            <div class="field"><label>Benutzername</label><input id="fUserName" /></div>
            <div class="field"><label>Passwort <span id="pwHint" style="text-transform:none;letter-spacing:0;color:var(--muted)"></span></label><input id="fPassword" type="password" autocomplete="new-password" placeholder="••••••••" /></div>
            <div class="field"><label>Absender-Adresse (From) *</label><input id="fSender" type="email" placeholder="office@deinefirma.at" /></div>
            <div class="field"><label>Absender-Anzeigename</label><input id="fSenderDisplayName" placeholder="leer = Firmenname" /></div>
        </div>
    </div>

    <aside>
        <div class="sb-heading">Hinweise</div>
        <div style="padding-top:6px">
            <div class="note-item">Port 465 = implizites SSL, Port 587 = STARTTLS. Im Zweifel 587.</div>
            <div class="note-item">Das Passwort wird verschlüsselt gespeichert und nie wieder angezeigt — zum Ändern einfach neu eintragen.</div>
            <div class="note-item">„Test-Mail senden" schickt eine Probe-Mail an die Absender-Adresse.</div>
        </div>

        <div class="sb-heading" style="margin-top:28px">Weitere Einstellungen</div>
        <div style="padding-top:14px">← <a class="aside-link" href="/Settings/CompanyProfile">Firmenprofil</a></div>
    </aside>
</div>

@section Scripts {
    <script src="~/js/api.js" asp-append-version="true"></script>
    <script src="~/js/mail-settings.js" asp-append-version="true"></script>
}
