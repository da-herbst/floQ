@page
@model floQ.Web.Pages.Settings.MailModel
@{
    Layout = "_LayoutApp";
    ViewData["Title"] = "E-Mail-Versand";
    ViewData["NavActive"] = "settings";
}

<div class="page-head">
    <div>
        <div class="page-title">E-Mail-Versand</div>
        <div class="page-sub">Belege gehen über deinen eigenen Mail-Server raus — dein Kunde sieht nur deinen Absender.</div>
    </div>
    <div class="hstack">
        <button class="btn btn-secondary" id="btnTestMail">Test-Mail senden</button>
        <button class="btn btn-primary" id="btnSaveMail">Speichern</button>
    </div>
</div>

<div class="two-col">
    <div class="card">
        <div class="card-header"><div class="card-title">SMTP-Zugang</div></div>
        <div class="card-body form-grid">
            <div class="field"><label>Host *</label><input id="fHost" placeholder="smtp.example.at" /></div>
            <div class="field"><label>Port</label><input id="fPort" type="number" value="587" min="1" max="65535" /></div>
            <div class="field span-2"><label>Benutzername</label><input id="fUserName" /></div>
            <div class="field span-2"><label>Passwort <span class="t-muted" id="pwHint"></span></label><input id="fPassword" type="password" autocomplete="new-password" placeholder="••••••••" /></div>
            <div class="field"><label>Absender-Adresse (From) *</label><input id="fSender" type="email" placeholder="office@deinefirma.at" /></div>
            <div class="field"><label>Absender-Anzeigename</label><input id="fSenderDisplayName" placeholder="leer = Firmenname" /></div>
        </div>
    </div>

    <aside>
        <div class="card card-body">
            <div class="sb-heading">Hinweise</div>
            <div class="t-sm t-muted" style="line-height:1.6">
                Port 465 = implizites SSL, Port 587 = STARTTLS.<br /><br />
                Das Passwort wird verschlüsselt gespeichert und nie wieder angezeigt —
                zum Ändern einfach neu eintragen.<br /><br />
                „Test-Mail senden" schickt eine Probe-Mail an die Absender-Adresse.
            </div>
        </div>
        <div class="card card-body">
            <div class="sb-heading">Weitere Einstellungen</div>
            <a class="btn btn-secondary btn-sm" href="/Settings/CompanyProfile">Firmenprofil</a>
        </div>
    </aside>
</div>

@section Scripts {
    <script src="~/js/api.js" asp-append-version="true"></script>
    <script src="~/js/mail-settings.js" asp-append-version="true"></script>
}
