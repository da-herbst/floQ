@page
@model floQ.Web.Pages.Billing.DocumentsModel
@{
    Layout = "_LayoutApp";
    ViewData["Title"] = "Belege";
    ViewData["NavActive"] = "documents";
}

<div class="page-head">
    <div>
        <div class="page-title">Belege</div>
        <div class="page-sub"><span id="countShown">0</span> von <span id="countTotal">0</span></div>
    </div>
    <button class="btn btn-primary" id="btnNewDocument">+&nbsp;&nbsp;Neuer Beleg</button>
</div>

<div class="two-col">
    <div class="ent-list topline" id="docList">
        <div class="ent-empty">Lädt …</div>
    </div>

    <aside>
        <div class="sb-heading">Status</div>
        <div class="filter-list" id="statusPills"></div>

        <div class="sb-heading" style="margin-top:28px">Belegart</div>
        <div class="filter-list" id="typePills"></div>

        <div class="sb-heading" style="margin-top:28px">Ergebnis</div>
        <div class="meta-list">
            <div class="meta-row"><span>Belege</span><span class="meta-value" id="sumCount">0</span></div>
            <div class="meta-row"><span>Entwürfe</span><span class="meta-value" id="sumDrafts">0</span></div>
            <div class="meta-row"><span>Σ Brutto</span><span class="meta-value" id="sumGross">–</span></div>
        </div>
    </aside>
</div>

@* Belegtyp-Auswahl für „Neuer Beleg" *@
<div class="modal-scrim" id="newDocModal" hidden>
    <div class="modal">
        <div class="modal-header">
            <div class="modal-eyebrow">Neuer Beleg</div>
            <div class="modal-title">Belegtyp wählen</div>
        </div>
        <div class="modal-body pick">
            <div class="pick-list">
                <button class="pick-item" type="button" data-new-type="2"><span class="pi-code">RE</span><span class="pi-label">Rechnung</span></button>
                <button class="pick-item" type="button" data-new-type="1"><span class="pi-code">AN</span><span class="pi-label">Angebot</span></button>
                <button class="pick-item" type="button" data-new-type="3"><span class="pi-code">GS</span><span class="pi-label">Gutschrift</span><span class="pi-hint">wählt Originalrechnung</span></button>
                <button class="pick-item" type="button" data-new-type="4"><span class="pi-code">SR</span><span class="pi-label">Stornorechnung</span><span class="pi-hint">wählt Originalrechnung</span></button>
                <button class="pick-item" type="button" data-new-type="5"><span class="pi-code">MA</span><span class="pi-label">Mahnung</span><span class="pi-hint">wählt Originalrechnung</span></button>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn-text" type="button" data-modal-close>Abbrechen</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/api.js" asp-append-version="true"></script>
    <script src="~/js/billing-documents.js" asp-append-version="true"></script>
}
