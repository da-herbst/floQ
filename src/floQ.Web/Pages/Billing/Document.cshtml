@page
@model floQ.Web.Pages.Billing.DocumentModel
@{
    Layout = "_LayoutApp";
    ViewData["Title"] = "Beleg";
    ViewData["NavActive"] = "documents";
}

<div class="page-head">
    <div>
        <div class="page-title"><span id="docTypeName">Beleg</span> <span id="docNumber" class="num"></span></div>
        <div class="page-sub" id="docSub"></div>
    </div>
    <a class="btn-text" href="/Billing/Documents">Zur Liste</a>
</div>

<div class="two-col">
    <div>
        <div class="tabbar" id="tabbar">
            <button class="tab is-active" type="button" data-tab="empfaenger">Empfänger</button>
            <button class="tab" type="button" data-tab="positionen" id="tabPositionen">Positionen</button>
            <button class="tab" type="button" data-tab="rechnungen" id="tabRechnungen" hidden>Rechnungen</button>
            <button class="tab" type="button" data-tab="details">Details</button>
            <button class="tab" type="button" data-tab="vorschau">Vorschau</button>
        </div>

        @* ── Tab: Empfänger (autarker Beleg: Snapshot ist die Wahrheit) ── *@
        <div data-tabpanel="empfaenger">
            <div class="panel-head">
                <div>
                    <div class="panel-title">Empfänger</div>
                    <div class="panel-sub">Direkt eintippen — der Beleg ist autark, kein Kundenstamm nötig.</div>
                </div>
            </div>
            <div class="form-grid" style="margin-top:24px" id="recipientForm">
                <div class="field span-2"><label>Name *</label><input id="fRecipientName" /></div>
                <div class="field span-2"><label>Adresse</label><input id="fRecipientAddress" /></div>
                <div class="field"><label>PLZ</label><input id="fRecipientZip" /></div>
                <div class="field"><label>Ort</label><input id="fRecipientCity" /></div>
                <div class="field"><label>Land (ISO-2)</label><input id="fRecipientCountry" maxlength="2" placeholder="AT" /></div>
                <div class="field"><label>UID</label><input id="fRecipientUid" placeholder="ATU…" /></div>
                <div class="field span-2"><label>E-Mail</label><input id="fRecipientEmail" type="email" /></div>
            </div>
        </div>

        @* ── Tab: Positionen (Freitext, ohne Artikel-Zwang) ── *@
        <div data-tabpanel="positionen" hidden>
            <div class="panel-head">
                <div class="panel-title">Positionen</div>
                <button class="btn-text" type="button" id="btnAddEntry">+ Position</button>
            </div>
            <div class="entries-wrap">
                <table class="entries-table">
                    <colgroup>
                        <col class="c-desc" /><col class="c-qty" /><col class="c-unit" /><col class="c-price" /><col class="c-vat" /><col class="c-net" /><col class="c-act" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th class="l">Bezeichnung</th>
                            <th>Menge</th>
                            <th class="l">Einheit</th>
                            <th>Einzelpreis</th>
                            <th>USt</th>
                            <th>Netto</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="entriesBody"></tbody>
                </table>
            </div>
            <div class="totals-box" id="totalsBox"></div>
        </div>

        @* ── Tab: Rechnungen (nur Mahnung) ── *@
        <div data-tabpanel="rechnungen" hidden>
            <div class="panel-head"><div class="panel-title">Gemahnte Rechnungen</div></div>
            <div class="ent-list topline" id="reminderInvoiceList" style="margin-top:8px"></div>
            <div class="form-grid" style="margin-top:32px">
                <div class="field select-wrap"><label>Mahnstufe</label>
                    <select id="fReminderLevel">
                        <option value="0">Zahlungserinnerung</option>
                        <option value="1">1. Mahnung</option>
                        <option value="2">2. Mahnung</option>
                        <option value="3">3. Mahnung</option>
                    </select>
                </div>
                <div class="field"><label>Zahlungsziel</label><input id="fReminderDueDate" type="date" /></div>
                <div class="field mono"><label>Mahngebühr €</label><input id="fReminderFee" type="number" step="0.01" min="0" /></div>
                <div class="field mono"><label>Verzugszinsen € (optional)</label><input id="fInterestAmount" type="number" step="0.01" min="0" /></div>
            </div>
        </div>

        @* ── Tab: Details ── *@
        <div data-tabpanel="details" hidden>
            <div class="panel-head"><div class="panel-title">Details</div></div>
            <div class="form-grid" style="margin-top:24px">
                <div class="field"><label>Belegdatum</label><input id="fDate" type="date" /></div>
                <div class="field" data-only="1,2"><label>Leistungsdatum</label><input id="fServiceDate" type="date" /></div>
                <div class="field" data-only="1,2"><label>Leistungszeitraum von</label><input id="fPeriodStart" type="date" /></div>
                <div class="field" data-only="1,2"><label>Leistungszeitraum bis</label><input id="fPeriodEnd" type="date" /></div>
                <div class="field" data-only="1"><label>Gültig bis</label><input id="fValidUntil" type="date" /></div>
                <div class="field" data-only="1"><label>Referenz</label><input id="fExternalReference" /></div>
                <div class="field mono"><label>Zahlungsziel (Tage)</label><input id="fPaymentTermDays" type="number" min="0" /></div>
                <div class="field mono"><label>Skonto-Frist (Tage)</label><input id="fPaymentTermDiscountDays" type="number" min="0" /></div>
                <div class="field mono"><label>Skonto %</label><input id="fDiscountRate" type="number" step="0.01" min="0" /></div>
                <div class="field select-wrap"><label>Steuerbefreiung</label>
                    <select id="fReverseChargeMode">
                        <option value="0">Keine (USt ausweisen)</option>
                        <option value="3">Kleinunternehmer (§6 Abs 1 Z 27 UStG)</option>
                        <option value="1">Reverse Charge EU-B2B</option>
                        <option value="2">Drittland (nicht steuerbar)</option>
                    </select>
                </div>
                <div class="field span-2"><label>Hinweistext Steuerbefreiung (leer = Standard)</label><textarea id="fReverseChargeNote" rows="2"></textarea></div>
                <div class="field span-2" data-only="1"><label>Konditionen (unter der Positionstabelle gedruckt)</label><textarea id="fConditionNotes" rows="3"></textarea></div>
                <div class="field span-2"><label>Notiz</label><textarea id="fNote" rows="2"></textarea></div>
            </div>
        </div>

        @* ── Tab: Vorschau ── *@
        <div data-tabpanel="vorschau" hidden>
            <div class="preview-wrap">
                <div class="preview-loading" id="previewLoading">PDF wird erzeugt …</div>
                <iframe class="preview-frame" id="previewFrame" title="Beleg-Vorschau"></iframe>
            </div>
        </div>
    </div>

    @* ── Aside: Status + Aktionen + Versand + Zahlungen ── *@
    <aside>
        <div class="sb-heading">Status</div>
        <div class="meta-list">
            <div id="asideStatus"></div>
            <div class="meta-row"><span>Nummer</span><span class="meta-value" id="asideNumber">–</span></div>
            <div class="meta-row"><span>Brutto</span><span class="meta-value" id="asideGross">–</span></div>
        </div>

        <div class="sb-heading" style="margin-top:24px">Aktionen</div>
        <div class="btn-stack" style="padding-top:18px">
            <button class="btn btn-primary" type="button" id="btnFinalize">Abschließen</button>
            <button class="btn btn-secondary" type="button" id="btnSave">Speichern</button>
            <button class="btn btn-primary" type="button" id="btnSend" hidden>Versenden</button>
            <a class="btn btn-secondary" id="btnDownload" hidden>PDF herunterladen</a>
            <button class="btn btn-ghost" type="button" id="btnProcess" hidden>Weiterverarbeiten</button>
            <button class="btn-text" type="button" id="btnDelete">Entwurf verwerfen</button>
            <button class="btn-text" type="button" id="btnUnlock" hidden>Entsperren</button>
        </div>

        <div id="distributionsCard" hidden>
            <div class="sb-heading" style="margin-top:28px">Versand</div>
            <div id="distributionsList" style="padding-top:6px"></div>
        </div>

        <div id="paymentsCard" hidden>
            <div class="sb-heading" style="margin-top:28px">Zahlungen</div>
            <div id="paymentsList" style="padding-top:6px"></div>
            <button class="btn-text" type="button" id="btnAddPayment" style="margin-top:14px">+ Zahlung erfassen</button>
        </div>
    </aside>
</div>

@* ── Modal: Originalrechnung wählen (Gutschrift/Storno/Mahnung) ── *@
<div class="modal-scrim" id="pickInvoiceModal" hidden>
    <div class="modal">
        <div class="modal-header">
            <div class="modal-eyebrow" id="pickInvoiceEyebrow">Beleg</div>
            <div class="modal-title">Originalrechnung wählen</div>
        </div>
        <div class="modal-body pick"><div class="pick-list" id="pickInvoiceList"></div></div>
        <div class="modal-footer"><button class="btn-text" type="button" data-modal-close>Abbrechen</button></div>
    </div>
</div>

@* ── Modal: Weiterverarbeiten ── *@
<div class="modal-scrim" id="processModal" hidden>
    <div class="modal">
        <div class="modal-header">
            <div class="modal-eyebrow">Weiterverarbeiten</div>
            <div class="modal-title">Weiterverarbeiten zu …</div>
            <div class="modal-text">Erzeugt einen neuen Entwurf, vorausgefüllt mit Kopf und Positionen.</div>
        </div>
        <div class="modal-body pick">
            <div class="pick-list">
                <button class="pick-item" type="button" data-process-target="2"><span class="pi-code">RE</span><span class="pi-label">Rechnung</span></button>
                <button class="pick-item" type="button" data-process-target="1"><span class="pi-code">AN</span><span class="pi-label">Angebot</span></button>
                <button class="pick-item" type="button" data-process-target="3"><span class="pi-code">GS</span><span class="pi-label">Gutschrift</span></button>
                <button class="pick-item" type="button" data-process-target="4"><span class="pi-code">SR</span><span class="pi-label">Stornorechnung</span></button>
                <button class="pick-item" type="button" data-process-target="5"><span class="pi-code">MA</span><span class="pi-label">Mahnung</span></button>
            </div>
        </div>
        <div class="modal-footer"><button class="btn-text" type="button" data-modal-close>Abbrechen</button></div>
    </div>
</div>

@* ── Modal: Beleg versenden ── *@
<div class="modal-scrim" id="sendModal" hidden>
    <div class="modal">
        <div class="modal-header">
            <div class="modal-eyebrow" id="sendEyebrow">Versand</div>
            <div class="modal-title">Beleg versenden</div>
        </div>
        <div class="modal-body">
            <div class="form-grid">
                <div class="field span-2"><label>Empfänger-E-Mail *</label><input id="sRecipient" type="email" /></div>
                <div class="field span-2"><label>Persönliche Nachricht</label><textarea id="sMessage" rows="3" placeholder="Optional — steht über dem Dokument-Link."></textarea></div>
            </div>
            <div class="field-check" style="margin-top:24px">
                <input type="checkbox" id="sAttachPdf" />
                <label for="sAttachPdf">PDF als Datei-Anhang statt Ansichts-Link</label>
            </div>
            <div class="field-check" style="margin-top:12px">
                <input type="checkbox" id="sCopyToSelf" checked />
                <label for="sCopyToSelf">Kopie an mich (Firmen-E-Mail)</label>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn-text" type="button" data-modal-close>Abbrechen</button>
            <button class="btn btn-primary" type="button" id="btnConfirmSend">Senden</button>
        </div>
    </div>
</div>

@* ── Modal: Zahlung erfassen ── *@
<div class="modal-scrim" id="paymentModal" hidden>
    <div class="modal narrow">
        <div class="modal-header">
            <div class="modal-eyebrow">Zahlung erfassen</div>
        </div>
        <div class="modal-body">
            <div class="form-grid">
                <div class="field mono"><label>Betrag € *</label><input id="pAmount" type="number" step="0.01" min="0.01" /></div>
                <div class="field"><label>Zahldatum *</label><input id="pDate" type="date" /></div>
                <div class="field select-wrap span-2"><label>Zahlungsweg</label>
                    <select id="pMethod">
                        <option value="1">Überweisung</option>
                        <option value="2">Bar</option>
                        <option value="3">Karte</option>
                        <option value="4">SEPA-Lastschrift</option>
                        <option value="99">Sonstige</option>
                    </select>
                </div>
                <div class="field span-2"><label>Referenz</label><input id="pReference" /></div>
                <div class="field span-2"><label>Notiz</label><input id="pNote" /></div>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn-text" type="button" data-modal-close>Abbrechen</button>
            <button class="btn btn-primary" type="button" id="btnSavePayment">Erfassen</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/api.js" asp-append-version="true"></script>
    <script src="~/js/billing-document.js" asp-append-version="true"></script>
}
