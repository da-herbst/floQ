@page
@model floQ.Web.Pages.Billing.IndexModel
@{
    Layout = "_LayoutApp";
    ViewData["Title"] = "Übersicht";
    ViewData["NavActive"] = "dashboard";
}

<div class="page-head">
    <div>
        <div class="page-title">Übersicht</div>
        <div class="page-sub" id="dashDate"></div>
    </div>
    <button class="btn btn-primary" id="btnNewInvoice">+&nbsp;&nbsp;Neue Rechnung</button>
</div>

<div class="kpi-grid" id="kpiGrid">
    <div class="kpi"><div class="kpi-label">Entwürfe</div><div class="kpi-value">–</div></div>
    <div class="kpi"><div class="kpi-label">Offene Forderungen</div><div class="kpi-value">–</div></div>
    <div class="kpi"><div class="kpi-label">Überfällig</div><div class="kpi-value">–</div></div>
    <div class="kpi"><div class="kpi-label">Umsatz</div><div class="kpi-value">–</div></div>
</div>

<div class="dash-cols">
    <div>
        <div class="list-head">
            <div class="hstack" style="gap:14px;align-items:baseline">
                <span class="lh-title">Überfällige Rechnungen</span>
                <span class="lh-sub">nach Fälligkeit</span>
            </div>
            <a class="lh-link" href="/Billing/Documents">Alle Belege</a>
        </div>
        <div class="ent-list" id="overdueList">
            <div class="ent-empty">Lädt …</div>
        </div>
    </div>

    <div>
        <div class="list-head"><span class="lh-title">Zuletzt bearbeitet</span></div>
        <div class="ent-list" id="recentList">
            <div class="ent-empty">Lädt …</div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/api.js" asp-append-version="true"></script>
    <script src="~/js/billing-dashboard.js" asp-append-version="true"></script>
}
