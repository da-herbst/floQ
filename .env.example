# floQ Production-Secrets
# Auf dem Server unter /opt/floq/.env ablegen — niemals ins Git committen.
# Auf dem lokalen Rechner wird diese Datei nicht benoetigt
# (lokales Postgres in compose.yaml nutzt feste Dev-Credentials).

POSTGRES_PASSWORD=change-me-to-something-strong

# Shared Platform-Key fuer die batOSAdminCenter-Anbindung (Abo-Verwaltung).
# Muss mit dem im AC hinterlegten Key uebereinstimmen. Leer = Sync inaktiv.
AdminCenter__PlatformKey=

# Internes Secret der PDF-Pipeline (Playwright-Self-Calls). PFLICHT —
# compose startet ohne nicht. Erzeugen: openssl rand -hex 32
PDF_RENDER_SECRET=

# SMTP-Passwort des zentralen floQ-System-Absenders (Login-Codes etc.).
# Host/Port/UserName/Sender stehen in appsettings.Production.json bzw.
# per ENV (SystemMail__Host usw.). Leer = Codes koennen nicht zugestellt
# werden (Dev loggt den Code stattdessen).
SystemMail__Password=
